{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Frontend (Flutter Web - Chrome)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/opalsnz_accounting_app",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": [
        "--web-port",
        "8081",
        "--dart-define=API_BASE_URL=http://localhost:5064"
      ]
    },
    {
      "name": "Frontend (Flutter Web Server :8081)",
      "request": "launch",
      "type": "dart",
      "cwd": "${workspaceFolder}/frontend/opalsnz_accounting_app",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": [
        "--web-port",
        "8081",
        "--dart-define=API_BASE_URL=http://localhost:5064"
      ]
    }
  ]
}
